{% extends 'base.html.twig' %}

{% block title %}Lodging index{% endblock %}

{% block body %}
    <h1>Lodging index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>images</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lodging in lodgings %}
            <tr>
                <td>{{ lodging.id }}</td>
                <td>{{ lodging.name }}</td>
                <td><img width="200px" alt="pas d'images" src="{% if picturesTab %}{{ picturesTab[0] }}{% else %}null{% endif %}"/></td>
            
                
                <td>
                    <a href="{{ path('app_lodging_show', {'id': lodging.id}) }}">show</a>
                    <a href="{{ path('app_lodging_edit', {'id': lodging.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_lodging_new') }}">Create new</a>
{% endblock %}
